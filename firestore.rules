rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aprobado = tiene documento en users y no está marcado approved: false.
    // Sin el campo `approved` es un usuario antiguo, que se considera aprobado.
    function isApproved() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', true) == true;
    }

    // Por defecto, solo los usuarios aprobados acceden a los datos
    match /{document=**} {
      allow read, write: if isApproved();
    }

    // Usuarios: esta regla se suma a la general, para que un pendiente pueda
    // ver su propio documento y registrarse, sin poder aprobarse a sí mismo.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.approved == false;
      // Pendientes antiguos sin rol: useAuthStore les asigna 'member' al entrar
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !('role' in resource.data)
        && request.resource.data.role == 'member'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
    }
  }
}
